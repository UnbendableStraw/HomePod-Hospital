+	if (devinfo->state != BRCMFMAC_PCIE_STATE_UP || !devinfo->tcm ||
+	    !console->base_addr)
+		return 0;
+	size = console->bufsize;
+	if (!size || size > SZ_256K ||
+	    (u64)console->buf_addr + size > devinfo->tcm_size)
+		return 0;
+	buf = kvmalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	widx = brcmf_pcie_read_tcm32(devinfo, console->base_addr +
+				     BRCMF_CONSOLE_WRITEIDX_OFFSET);
+	if (widx >= size)
+		widx = 0;
+	memcpy_fromio(buf, devinfo->tcm + console->buf_addr, size);
+	for (i = 0; i < size; i++) {
+		u8 ch = buf[(widx + i) % size];
