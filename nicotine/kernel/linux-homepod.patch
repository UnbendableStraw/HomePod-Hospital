+				       "    (none in the last %d operations)\n", S5L_HIST);
+		o += scnprintf(r + o, S5L_REPORT_SZ - o, "  last operations overall, newest first:\n");
+		for (k = 0; k < 6 && k < s5l.head; k++)
+			o += s5l_fmt_op(r + o, S5L_REPORT_SZ - o,
+					&s5l.hist[(s5l.head - 1 - k) % S5L_HIST], now);
+	}
+	s5l.last_err = err;
+	s5l.last_addr = addr;
+	spin_unlock_irqrestore(&s5l.lock, flags);
+
+	if (s5l_console) {
+		s5l_console--;
+		pr_warn("dart-s5l: event %u (%s): +0x10=%08x +0x1c=%08x page %06lx pte=%llx %s\n",
+			n, why, err, addr, page, pte[1],
+			mapped_now ? "mapped" : "NOT mapped");
+		pr_warn("dart-s5l:   %lld us after an invalidate, %lld us after a map, %lld us after an unmap; details: /sys/kernel/debug/apple-dart-s5l/events\n",
