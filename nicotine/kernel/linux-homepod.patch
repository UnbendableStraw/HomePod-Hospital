+/* Create the static pools asked for on the command line.  Any failure just
+ * leaves the direction concerned in the normal per-packet mapping mode.
+ */
+static void brcmf_msgbuf_setup_pools(struct brcmf_msgbuf *msgbuf)
+{
+	struct device *dev = msgbuf->drvr->bus_if->dev;
+	struct brcmf_msgbuf_pktids *rx = msgbuf->rx_pktids;
+	struct brcmf_msgbuf_pktids *tx = msgbuf->tx_pktids;
+
+	if (brcmf_static_rx) {
+		rx->pool = brcmf_msgbuf_pool_create(dev, rx->array_size -
+						    BRCMF_POOL_RX_CTL_SLOTS,
+						    BRCMF_MSGBUF_MAX_PKT_SIZE,
+						    DMA_BIDIRECTIONAL);
+		rx->ctl_pool = brcmf_msgbuf_pool_create(dev,
+						BRCMF_POOL_RX_CTL_SLOTS,
+						BRCMF_MSGBUF_MAX_CTL_PKT_SIZE,
+						DMA_BIDIRECTIONAL);
+		if (rx->pool && rx->ctl_pool) {
+			rx->nr_ctl = BRCMF_POOL_RX_CTL_SLOTS;
+			rx->last_allocated_idx = rx->nr_ctl;
+			if (msgbuf->max_rxbufpost > rx->pool->slots - 32)
+				msgbuf->max_rxbufpost = rx->pool->slots - 32;
+		} else {
+			brcmf_msgbuf_pool_destroy(rx->pool);
+			brcmf_msgbuf_pool_destroy(rx->ctl_pool);
+			rx->pool = NULL;
+			rx->ctl_pool = NULL;
+			pr_warn("brcmfmac: static_rx pool allocation failed, using per-packet mapping\n");
+		}
+	}
+
+	if (brcmf_static_tx) {
+		tx->pool = brcmf_msgbuf_pool_create(dev, tx->array_size,
+						    BRCMF_MSGBUF_MAX_PKT_SIZE,
+						    DMA_TO_DEVICE);
+		if (!tx->pool)
+			pr_warn("brcmfmac: static_tx pool allocation failed, using per-packet mapping\n");
+	}
+
+	if (rx->pool || tx->pool)
+		pr_info("brcmfmac: static pools: rx %u data + %u ctl slots, tx %u slots\n",
+			rx->pool ? rx->pool->slots : 0,
+			rx->pool ? rx->nr_ctl : 0,
+			tx->pool ? tx->pool->slots : 0);
+}
+
+static u32 brcmf_msgbuf_pktids_in_use(struct brcmf_msgbuf_pktids *pktids)
+{
+	u32 i, n = 0;
+
+	for (i = 0; i < pktids->array_size; i++)
+		if (pktids->array[i].allocated.counter)
+			n++;
+	return n;
+}
