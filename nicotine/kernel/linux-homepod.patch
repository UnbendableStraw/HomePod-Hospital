+/*
+ * T7000: program the board specific PHY settings. Apple does this once per
+ * PHY when the controller is powered up, with the clocks of the first port
+ * of the pair (and nothing else) running, and puts everything back
+ * afterwards.
+ *
+ * "apple,phy-settings" is Apple's "phyN-settings" property: <offset value>
+ * pairs. Only PHY 0 is described for now.
+ */
+static int apple_pcie_t7000_phy_init(struct apple_pcie *pcie, unsigned int phy)
+{
+	struct platform_device *platform = to_platform_device(pcie->dev);
+	struct device_node *np = pcie->dev->of_node;
+	unsigned int first = phy * 2;
+	void __iomem *base;
+	char name[16];
+	int i, n;
+
+	if (phy >= T7000_MAX_PHYS)
+		return -EINVAL;
+
+	if (pcie->t7000_phy[phy])
+		return 0;
+
+	snprintf(name, sizeof(name), "phy%u", phy);
+	base = devm_platform_ioremap_resource_byname(platform, name);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	pcie->t7000_phy[phy] = base;
+
+	rmw_set(T7000_CORE_PHY_CLK_EN, pcie->base + T7000_CORE_PHY_CLK(first));
+	rmw_set(T7000_CORE_PORT_APPCLK_EN,
+		pcie->base + T7000_CORE_PORT_APPCLK(first));
+	rmw_set(T7000_CORE_PORT_PERST_OFF,
+		pcie->base + T7000_CORE_PORT_PERST(first));
+
+	if (of_property_read_bool(np, "apple,phy-external-refclk")) {
+		writel_relaxed(1, base + T7000_PHY_EXT_REFCLK);
+		readl_relaxed(base + T7000_PHY_EXT_REFCLK);
+	}
+
+	n = phy ? 0 : of_property_count_u32_elems(np, "apple,phy-settings");
+	for (i = 0; i + 1 < n; i += 2) {
+		u32 off, val;
+
+		if (of_property_read_u32_index(np, "apple,phy-settings", i, &off) ||
+		    of_property_read_u32_index(np, "apple,phy-settings", i + 1, &val))
+			break;
+		if (off > 0xffc || (off & 3)) {
+			dev_warn(pcie->dev, "bad PHY setting offset %#x\n", off);
+			continue;
+		}
+
+		writel_relaxed(val, base + off);
+		/* Apple reads every setting back */
+		readl_relaxed(base + off);
+	}
+
+	rmw_clear(T7000_CORE_PORT_PERST_OFF,
+		  pcie->base + T7000_CORE_PORT_PERST(first));
+	rmw_clear(T7000_CORE_PORT_APPCLK_EN,
+		  pcie->base + T7000_CORE_PORT_APPCLK(first));
+	rmw_clear(T7000_CORE_PHY_CLK_EN, pcie->base + T7000_CORE_PHY_CLK(first));
+
+	return 0;
+}
+
+/*
+ * T7000: the root port's configuration space is used before the bus is
+ * scanned, to limit the link speed like Apple's driver does.
+ */
+static void apple_pcie_t7000_limit_speed(struct apple_pcie *pcie,
+					 struct apple_pcie_port *port)
+{
+	void __iomem *cfg = pcie->cfg_win + (PCI_DEVFN(port->idx, 0) << 12);
+	u32 speed, lnkcap2;
+	int ttl = 48;
+	u8 pos, cap = 0;
+	u16 lnkctl2;
+
+	if (of_property_read_u32(port->np, "max-link-speed", &speed) &&
+	    of_property_read_u32(pcie->dev->of_node, "max-link-speed", &speed))
+		return;
+
+	if (!speed || speed > 4)
+		return;
+
+	if (!(readw_relaxed(cfg + PCI_STATUS) & PCI_STATUS_CAP_LIST))
+		goto no_cap;
+
+	pos = readb_relaxed(cfg + PCI_CAPABILITY_LIST) & ~3;
+	while (pos >= 0x40 && ttl--) {
+		if (readb_relaxed(cfg + pos + PCI_CAP_LIST_ID) == PCI_CAP_ID_EXP) {
+			cap = pos;
+			break;
+		}
+		pos = readb_relaxed(cfg + pos + PCI_CAP_LIST_NEXT) & ~3;
+	}
+
+	if (!cap)
+		goto no_cap;
+
+	/* Bits 7:1 of LNKCAP2 are the supported link speeds vector */
+	lnkcap2 = readl_relaxed(cfg + cap + PCI_EXP_LNKCAP2);
+	while (speed > 1 && lnkcap2 && !(lnkcap2 & BIT(speed)))
+		speed--;
+
+	lnkctl2 = readw_relaxed(cfg + cap + PCI_EXP_LNKCTL2);
+	lnkctl2 &= ~PCI_EXP_LNKCTL2_TLS;
+	lnkctl2 |= speed;
+	writew_relaxed(lnkctl2, cfg + cap + PCI_EXP_LNKCTL2);
+
+	dev_dbg(pcie->dev, "%pOF: target link speed %u (LNKCAP2 %#x)\n",
+		port->np, speed, lnkcap2);
+	return;
+
+no_cap:
+	dev_warn(pcie->dev, "%pOF: no PCIe capability in the root port (vid:did %#x), link speed not limited\n",
+		 port->np, readl_relaxed(cfg + PCI_VENDOR_ID));
+}
+
+/*
+ * T7000: "apple,port-tunables" is Apple's "apcie-config-tunables" property:
+ * <offset mask value> triplets for the port register block.
+ */
+static void apple_pcie_t7000_port_tunables(struct apple_pcie *pcie,
+					   struct apple_pcie_port *port)
+{
+	struct device_node *np = pcie->dev->of_node;
+	int i, n;
+
+	n = of_property_count_u32_elems(np, "apple,port-tunables");
+	for (i = 0; i + 2 < n; i += 3) {
+		u32 off, mask, val, reg;
+
+		if (of_property_read_u32_index(np, "apple,port-tunables", i, &off) ||
+		    of_property_read_u32_index(np, "apple,port-tunables", i + 1, &mask) ||
+		    of_property_read_u32_index(np, "apple,port-tunables", i + 2, &val))
+			break;
+		if (off > 0xffc || (off & 3)) {
+			dev_warn(pcie->dev, "bad port tunable offset %#x\n", off);
+			continue;
+		}
+
+		reg = readl_relaxed(port->base + off);
+		writel_relaxed((reg & ~mask) | val, port->base + off);
+	}
+}
+
+static int apple_pcie_t7000_port_bringup(struct apple_pcie *pcie,
+					 struct apple_pcie_port *port,
+					 struct gpio_desc *reset)
+{
+	struct device_node *np = pcie->dev->of_node;
+	unsigned int idx = port->idx;
+	u32 delay = 100;
+	int ret;
+
+	/* Keep the endpoint in reset until the port is ready */
+	gpiod_set_value_cansleep(reset, 1);
+
+	/*
+	 * On HomePod (B238a), WiFi REG_ON is PMIC GPIO 5 on the Dialog
+	 * D2186 at I2C0 address 0x74. Drive it HIGH so the BCM4357 is
+	 * powered before link training. This is a board-specific hack;
+	 * a proper solution would use a regulator-fixed node.
+	 */
+	if (of_machine_is_compatible("apple,b238a")) {
+		struct i2c_adapter *pmu_bus;
+		struct device_node *i2c_np;
+
+		i2c_np = of_find_compatible_node(NULL, NULL, "apple,t7000-i2c");
+		if (i2c_np) {
+			pmu_bus = of_find_i2c_adapter_by_node(i2c_np);
+			of_node_put(i2c_np);
+			if (pmu_bus) {
+				/* GPIO 5 = REG_ON (chip power) */
+				u8 gpio5_set[] = { 0x04, 0x0a, 0x0b };
+				u8 gpio5_cfg[] = { 0x04, 0x0b, 0x12 };
+				/* GPIO 7 = WLAN enable (may control xtal/PLL) */
+				u8 gpio7_set[] = { 0x04, 0x0e, 0x0b };
+				u8 gpio7_cfg[] = { 0x04, 0x0f, 0x12 };
+				struct i2c_msg msgs[] = {
+					{ .addr = 0x74, .len = 3, .buf = gpio5_set },
+					{ .addr = 0x74, .len = 3, .buf = gpio5_cfg },
+					{ .addr = 0x74, .len = 3, .buf = gpio7_set },
+					{ .addr = 0x74, .len = 3, .buf = gpio7_cfg },
+				};
+				if (i2c_transfer(pmu_bus, msgs, 4) == 4)
+					dev_info(pcie->dev, "WiFi REG_ON (GPIO5) + WLAN_EN (GPIO7) driven HIGH\n");
+				else if (i2c_transfer(pmu_bus, msgs, 2) == 2)
+					dev_info(pcie->dev, "WiFi REG_ON (GPIO5) driven HIGH (GPIO7 failed)\n");
+				else
+					dev_warn(pcie->dev, "WiFi PMIC I2C write failed\n");
+				i2c_put_adapter(pmu_bus);
+				/* Wait for WiFi chip + crystal power-up */
+				msleep(100);
+			}
+		}
+	}
+
+	ret = apple_pcie_t7000_phy_init(pcie, idx / 2);
+	if (ret)
+		return ret;
+
+	/* Port reset on, then the reference clock (unless it is external) */
+	rmw_clear(T7000_CORE_PORT_PERST_OFF,
+		  pcie->base + T7000_CORE_PORT_PERST(idx));
+	if (!of_property_read_bool(np, "apple,phy-external-refclk"))
+		rmw_set(T7000_CORE_PORT_REFCLK_EN,
+			pcie->base + T7000_CORE_PORT_REFCLK(idx));
+
+	usleep_range(100, 200);
+
+	rmw_clear(T7000_CORE_PORT_OFF_SET, pcie->base + T7000_CORE_PORT_OFF(idx));
+	rmw_set(T7000_CORE_PORT_APPCLK_EN,
+		pcie->base + T7000_CORE_PORT_APPCLK(idx));
+	if (of_property_read_bool(np, "apple,muxed-auxclk-auto-dis"))
+		rmw_set(T7000_CORE_PORT_APPCLK_AUXDIS,
+			pcie->base + T7000_CORE_PORT_APPCLK(idx));
+
+	/* Apple's "t-refclk-to-perst", in microseconds */
+	of_property_read_u32(port->np, "apple,t-refclk-to-perst-us", &delay);
+	usleep_range(delay, delay + 100);
+
+	/* Port reset off */
+	rmw_set(T7000_CORE_PORT_PERST_OFF,
+		pcie->base + T7000_CORE_PORT_PERST(idx));
+
+	writel_relaxed(T7000_CORE_PORT_CTL_RUN,
+		       pcie->base + T7000_CORE_PORT_CTL(idx));
+
+	/* Allow the reference clock to be gated */
+	rmw_clear(T7000_CORE_PORT_REFCLK_CGDIS,
+		  pcie->base + T7000_CORE_PORT_REFCLK(idx));
+
+	/* The root port's configuration space is usable from here on */
+	apple_pcie_t7000_limit_speed(pcie, port);
+	apple_pcie_t7000_port_tunables(pcie, port);
+
+	/* Apple clears this next to the interrupt mask, meaning unknown */
+	writel_relaxed(0, port->base + PORT_T7000_INTMSK2);
+
+	return 0;
+}
