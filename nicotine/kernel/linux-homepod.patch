+static int brcmf_pcie_hp_fwcon_show(struct seq_file *s, void *unused)
+{
+	struct brcmf_pciedev_info *devinfo = s->private;
+	struct brcmf_pcie_console *console = &devinfo->shared.console;
+	u32 size, widx, i;
+	u8 *buf;
