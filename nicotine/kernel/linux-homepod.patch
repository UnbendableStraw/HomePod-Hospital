index 000000000..79fdc2a03
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t7000-b238a.dts
@@ -0,0 +1,655 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple HomePod (1st generation), B238a, AudioAccessory1,1 (A1639)
+ *
+ * target-type: B238a  (target-sub-type B238aAP, BDID 0x38, CPID 0x7000)
+ *
+ * Every address, interrupt and GPIO number in this file was taken from
+ * Apple's own device tree for this board (DeviceTree.b238aap.im4p, tag
+ * EmbeddedDeviceTrees-9682.80.53, audioOS 18.3 / 22K557, cross-checked
+ * against EmbeddedDeviceTrees-3480.40.4, audioOS 11.2.5 / 15D59).
+ * See t7000-b238a-NOTES.md for the full provenance of each node and for
+ * the list of things that are still guesses.
+ *
+ * Legend used in comments below:
+ *   [ADT]     value read from Apple's device tree
+ *   [DRIVER]  a Linux driver exists and binds to this node
+ *   [NODRV]   hardware description only: no binding and no driver exists,
+ *             the compatible string is a placeholder and the node is disabled
+ *   [GUESS]   not confirmed by any source
+ */
+
+/dts-v1/;
+
+#include "t7000.dtsi"
+#include "t7000-common.dtsi"
+
+/ {
+	compatible = "apple,b238a", "apple,t7000", "apple,arm-platform";
+	model = "Apple HomePod (1st generation)";
+	chassis-type = "embedded";
+
+	aliases {
+		/*
+		 * serial0 (debug console) and serial6 come from
+		 * t7000-common.dtsi. The loader (m1n1) copies the Wi-Fi and
+		 * Bluetooth MAC addresses out of SysCfg into whatever these
+		 * two aliases point at.
+		 */
+		serial1 = &serial1;
+		serial3 = &serial3;
+		serial8 = &serial8;
+		bluetooth0 = &bluetooth;
+		wifi0 = &wifi;
+	};
+
+	chosen {
+		/*
+		 * [ADT] /defaults/serial-device points at uart0, which also
+		 * carries "boot-console" and the "debug-console" child. This
+		 * is the 115200 8N1 UART on the debug connector under the
+		 * base. Note this differs from the Apple TV HD (serial6).
+		 */
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * 1 GiB of LPDDR3, package-on-package with the A8. The loader
+	 * replaces this with the real usable range (iBoot keeps the top of
+	 * RAM for TrustZone/SEP and its own carve-outs), so the value here
+	 * is only a default and must never be relied on without a loader.
+	 */
+	memory@800000000 {
+		device_type = "memory";
+		reg = <0x8 0x0 0x0 0x40000000>; /* To be filled by loader */
+	};
+
+	/*
+	 * Audio topology, as described by Apple's device tree:
+	 *
+	 *   6 far-field mics + 1 internal mic
+	 *        -> 2x Conexant/Synaptics "CX21810" ADC (i2c2 0x3b, 0x35)
+	 *        -> TDM -> MCA2 (capture)
+	 *
+	 *   MCA3 (playback, TDM) -> "Nitrogen" amplifier controller
+	 *        (STM32L051 on the power ring board, control over UART8)
+	 *        -> CS4350 DAC + IR class-D (woofer)
+	 *        -> 7x SSM3515B (tweeters)
+	 *
+	 * The DAC and the eight amplifiers are NOT visible on any SoC bus;
+	 * the STM32 owns them. MCA4 exists in Apple's tree with no consumer.
+	 *
+	 * [NODRV] There is no Linux driver for the A8-generation MCA, for the
+	 * CX21810 or for the Nitrogen protocol, so this card is disabled and
+	 * exists to record the routing.
+	 */
+	sound {
+		compatible = "apple,b238a-audio"; /* placeholder */
+		model = "HomePod";
+		status = "disabled";
+
+		dai-link-mics {
+			link-name = "Microphone array";
+
+			cpu {
+				sound-dai = <&mca2>;
+			};
+
+			codec {
+				sound-dai = <&mic_adc0>, <&mic_adc1>;
+			};
+		};
+
+		dai-link-speakers {
+			link-name = "Speakers";
+
+			cpu {
+				sound-dai = <&mca3>;
+			};
+
+			codec {
+				sound-dai = <&nitrogen>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* Debug console                                                       */
+/* ------------------------------------------------------------------ */
+
+&serial0 {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ */
+/* I2C0: PMU                                                           */
+/* ------------------------------------------------------------------ */
+
+&i2c0 {
+	status = "okay";
+
+	/*
+	 * [ADT] "pmu,d2186" at 0x74, 2500 (x100 Hz) bus speed.
+	 * IRQ: SoC GPIO 106. keepact: SoC GPIO 107.
+	 * PMU GPIO events: gpio7 "wlan", gpio10 "bluetooth", gpio15 "sense1",
+	 * gpio16 "sense2", gpio17 "nitro".
+	 *
+	 * [GUESS] The node below is copied from the other T7000 boards in the
+	 * HoolockLinux tree (Apple TV HD, iPhone 6, iPod touch 6), which sit
+	 * at the same address. That those boards also use a D2186 has not
+	 * been checked, so the RTC/NVMEM offsets are unverified here.
+	 */
+	pmic@74 {
+		compatible = "apple,adi-pmic", "apple,i2c-pmic";
+		reg = <0x74>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		rtc@5c0 {
+			compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
+			reg = <0x5c0 0x10>;
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+		};
+
+		nvmem@4000 {
+			compatible = "apple,pmic-nvmem";
+			reg = <0x4000 0x28>;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				rtc_offset: rtc-offset@4 {
+					reg = <0x4 0x4>;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * I2C1 is intentionally left disabled. The 11.2.5 device tree has an empty
+ * i2c1 node (no children) and the 18.3 tree drops it completely.
+ */
+
+/* ------------------------------------------------------------------ */
+/* I2C2: microphone ADCs and accelerometer                             */
+/* ------------------------------------------------------------------ */
+
+&i2c2 {
+	status = "okay";
+
+	/*
+	 * [ADT] accelerometer,bma282 at 0x18, "polling-mode" set, interrupt
+	 * routed through the PMU (PMU interrupt 0x26), not a SoC GPIO.
+	 * [DRIVER] bmc150-accel. The BMA282 has no compatible of its own; it
+	 * reports chip ID 0xfb, the BMA280 ID, so bosch,bma280 is used. No
+	 * interrupt is described, so the driver runs without a trigger.
+	 */
+	accelerometer@18 {
+		compatible = "bosch,bma280";
+		reg = <0x18>;
+	};
+
+	/*
+	 * [ADT] audio-control,cx21810 "audio-codec1" at 0x35 (secondary ADC,
+	 * referenced from codec0 through its "codec1" property).
+	 * [NODRV]
+	 */
+	mic_adc1: audio-codec@35 {
+		compatible = "cnxt,cx21810"; /* placeholder */
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] audio-control,cx21810 "audio-codec0" at 0x3b (primary ADC).
+	 * Reset: SoC GPIO 47 (Apple flags 0x10001; polarity is a [GUESS]).
+	 * Carries the SpGa / MiGa SysCfg calibration.
+	 * [NODRV]
+	 */
+	mic_adc0: audio-codec@3b {
+		compatible = "cnxt,cx21810"; /* placeholder */
+		reg = <0x3b>;
+		reset-gpios = <&pinctrl 47 GPIO_ACTIVE_LOW>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* I2C3: ambient light sensor and the top-board ("Peppy") MCU          */
+/* ------------------------------------------------------------------ */
+
+&i2c3 {
+	status = "okay";
+
+	/*
+	 * [ADT] als,ct821 at 0x29, interrupt through the PMU (0x27).
+	 * [NODRV] The vendor behind "ct821" is not identified.
+	 */
+	light-sensor@29 {
+		compatible = "apple,ct821-als"; /* placeholder */
+		reg = <0x29>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] peppy-mcu,1 at 0x55. This is the microcontroller on the top
+	 * board (the Cypress CY8C4245 PSoC in the teardown): it reports the
+	 * capacitive touch surface and drives the 19-zone LED matrix. Apple's
+	 * tree attaches the LED calibration (SysCfg "LEDc"), the LED
+	 * coordinates (MDXCoords/MDYCoords/MDRingCoords, 16-bit depth) and
+	 * the "backlight" LED update hooks to this node.
+	 *
+	 * The TI TLC5971 LED driver hangs off this MCU. It is NOT on a SoC
+	 * SPI bus: Apple's device tree for this board contains no SPI
+	 * controller at all, so no ti,tlc5971 node can be described here.
+	 *
+	 * Reset: PMU GPIO 19. Boot/bootloader select: SoC GPIO 45.
+	 * Interrupt: through the PMU (0x25).
+	 * [NODRV]
+	 */
+	peppy: mcu@55 {
+		compatible = "apple,peppy-mcu"; /* placeholder */
+		reg = <0x55>;
+		boot-gpios = <&pinctrl 45 GPIO_ACTIVE_HIGH>; /* polarity [GUESS] */
+		status = "disabled";
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* Peripherals that t7000.dtsi does not describe yet                    */
+/* ------------------------------------------------------------------ */
+
+&{/soc} {
+	/*
+	 * [ADT] i2s-switch,t7000: routes the MCA ports to the I2S pin groups.
+	 * [NODRV]
+	 */
+	i2s_switch: audio-mux@20a003000 {
+		compatible = "apple,t7000-i2s-switch"; /* placeholder */
+		reg = <0x2 0x0a003000 0x0 0x1000>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] mca,t7000 / mca,s5l8950x. This is the pre-M1 MCA: one
+	 * register block per port and DMA through the SIO coprocessor, not
+	 * ADMAC. The mainline "apple,mca" driver does not handle it.
+	 * MCLK comes from NCO channel 2/3/4.
+	 * [NODRV]
+	 */
+	mca2: i2s@20a0a8000 {
+		compatible = "apple,t7000-mca"; /* placeholder */
+		reg = <0x2 0x0a0a8000 0x0 0x4000>,
+		      <0x2 0x0a002008 0x0 0x4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 171 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_mca2>;
+		/* SIO DMA channels 0x2c (tx) / 0x2d (rx) */
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	mca3: i2s@20a0ac000 {
+		compatible = "apple,t7000-mca"; /* placeholder */
+		reg = <0x2 0x0a0ac000 0x0 0x4000>,
+		      <0x2 0x0a00200c 0x0 0x4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 172 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_mca3>;
+		/* SIO DMA channels 0x2e (tx) / 0x2f (rx) */
+		#sound-dai-cells = <0>;
+		/* Phase 3: enabled to power on ps_mca3 domain for audio path */
+		status = "okay";
+	};
+
+	mca4: i2s@20a0b0000 {
+		compatible = "apple,t7000-mca"; /* placeholder */
+		reg = <0x2 0x0a0b0000 0x0 0x4000>,
+		      <0x2 0x0a002010 0x0 0x4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 173 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_mca4>;
+		/* SIO DMA channels 0x30 (tx) / 0x31 (rx); no consumer in ADT */
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] uart1: Bluetooth HCI, 3,000,000 baud, RTS on SoC GPIO 175,
+	 * TX on SoC GPIO 173.
+	 * [DRIVER] apple,s5l-uart (the port itself). Left disabled because
+	 * the pin mux function for these pads has not been confirmed.
+	 */
+	serial1: serial@20a0c4000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0c4000 0x0 0x4000>;
+		reg-io-width = <4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 159 IRQ_TYPE_LEVEL_HIGH>;
+		/* Use the bootloader-enabled clocks for now. */
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart1>;
+		/*
+		 * Enabled so /dev/ttySAC1 exists for Bluetooth bring-up from
+		 * userspace. The pad mux for GPIO 173-176 is still unconfirmed.
+		 */
+		status = "okay";
+
+		/*
+		 * [ADT] "bluetooth,n88": the Bluetooth half of the BCM4357
+		 * combo chip. Wake: SoC GPIO 200. Power enable: PMU GPIO 4.
+		 * Host wake arrives as PMU event gpio10.
+		 * No compatible is given on purpose: no Linux Bluetooth
+		 * driver is known to support this chip, and without one the
+		 * node is ignored. It exists so the loader has somewhere to
+		 * put the MAC address (alias bluetooth0).
+		 */
+		bluetooth: bluetooth {
+			/* samsung_tty tops out at 24 MHz / 16 on this port */
+			max-speed = <1500000>;
+			device-wakeup-gpios = <&pinctrl 200 GPIO_ACTIVE_HIGH>;
+			local-bd-address = [00 00 00 00 00 00]; /* To be filled by loader */
+		};
+	};
+
+	/*
+	 * [ADT] uart3: Wi-Fi sideband/debug UART of the BCM4357
+	 * ("wlan-pcie-uart,bcm4357"). RTS SoC GPIO 180, TX SoC GPIO 178.
+	 * [DRIVER] apple,s5l-uart; disabled, pin mux unconfirmed.
+	 */
+	serial3: serial@20a0cc000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0cc000 0x0 0x4000>;
+		reg-io-width = <4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 161 IRQ_TYPE_LEVEL_HIGH>;
+		/* Use the bootloader-enabled clocks for now. */
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart3>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] uart8: control link to the amplifier controller, no flow
+	 * control, TX on SoC GPIO 58.
+	 * [DRIVER] apple,s5l-uart — ENABLED in Phase 3. Gives a raw tty
+	 * (/dev/ttySAC8) to the Nitrogen STM32 MCU for protocol work.
+	 */
+	serial8: serial@20a0e0000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0e0000 0x0 0x4000>;
+		reg-io-width = <4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 166 IRQ_TYPE_LEVEL_HIGH>;
+		/* Use the bootloader-enabled clocks for now. */
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart8>;
+		status = "okay";
+
+		/*
+		 * [ADT] "aeac-mcu,1" with child "audio-control,nitrogen":
+		 * the STM32L051 on the power ring board. It owns the CS4350
+		 * DAC, the IR woofer amplifier, the seven SSM3515B tweeter
+		 * amplifiers and thermal/current protection, and receives
+		 * audio as TDM from MCA3.
+		 *
+		 *   reset         PMU GPIO 20
+		 *   prog          SoC GPIO 76  (bootloader entry)
+		 *   nitro_buf_en  SoC GPIO 67  (level shifter/buffer enable)
+		 *   clock         PWM "lfosc-clk", 360 kHz default
+		 *   event         PMU gpio17 "nitro"
+		 *   calibration   SysCfg WFEQ, SpEQ
+		 *
+		 * The SSM3515B amplifiers are behind this MCU and are NOT
+		 * reachable from any SoC I2C bus, so there are no adi,ssm3515
+		 * nodes in this file. (The part only has four selectable I2C
+		 * addresses, so seven of them could not share one bus anyway.)
+		 * [NODRV]
+		 */
+		nitrogen: audio-controller {
+			compatible = "apple,nitrogen-amp"; /* placeholder */
+			prog-gpios = <&pinctrl 76 GPIO_ACTIVE_HIGH>; /* polarity [GUESS] */
+			enable-gpios = <&pinctrl 67 GPIO_ACTIVE_HIGH>; /* polarity [GUESS] */
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+	};
+
+	/*
+	 * [ADT] pwm,t7000: provides the low-frequency oscillator clock
+	 * (default 360000 Hz) that Apple enables for the amplifier MCU.
+	 * [NODRV]
+	 */
+	pwm: pwm@20a118000 {
+		compatible = "apple,t7000-pwm"; /* placeholder */
+		reg = <0x2 0x0a118000 0x0 0x1000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 178 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_pwm0>;
+		/* Phase 3: enabled to power on ps_pwm0 for 360kHz Nitrogen MCU clock */
+		status = "okay";
+	};
+
+	/*
+	 * [ADT] SIO coprocessor ("iop,s5l8960x", role SIO). Provides the DMA
+	 * service used by the MCA ports and by uart1/uart3. Needs firmware
+	 * (SmartIOFirmwareT7000) loaded before it does anything.
+	 * [NODRV]
+	 */
+	sio: sio@20ae00000 {
+		compatible = "apple,t7000-sio"; /* placeholder */
+		reg = <0x2 0x0ae00000 0x0 0x2000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 149 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 148 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 151 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 150 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_sio>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] ANS storage coprocessor ("iop,s5l8960x", role ANS) in front
+	 * of the 16 GB Toshiba NAND. The node itself (block@208040000,
+	 * "apple,t7000-ans") and its AKF mailbox (mbox@208041000) come from
+	 * t7000.dtsi and are enabled in t7000-common.dtsi; the loader fills
+	 * in the /reserved-memory/ans-firmware region.
+	 * [DRIVER] drivers/block/asp.c (CONFIG_APPLE_ASP)
+	 */
+
+	/*
+	 * [ADT] Secure Enclave ("iop,s5l8960x", role SEP).
+	 * Deliberately disabled and deliberately NOT given a "sep" alias, so
+	 * neither the loader nor the kernel will touch it.
+	 */
+	sep: sep@20da00000 {
+		compatible = "apple,t7000-sep", "apple,sep"; /* placeholder */
+		reg = <0x2 0x0da00000 0x0 0x2000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 98 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 97 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 100 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 99 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_sep>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] nco,t7000: numerically controlled oscillators that generate
+	 * the MCA master clocks.
+	 * [NODRV] Register compatibility with apple,nco (M1) is untested.
+	 */
+	nco: clock-controller@20e011000 {
+		compatible = "apple,t7000-nco"; /* placeholder */
+		reg = <0x2 0x0e011000 0x0 0x5000>;
+		clocks = <&clkref>;
+		#clock-cells = <1>;
+		status = "disabled";
+	};
+
+	/*
+	 * [ADT] dart-apcie1: dart,t7000 / dart,s5l8960x for PCIe port 1, one
+	 * stream (SID 0, "mapper-apcie1"). 4K pages, Apple's IOVA window is
+	 * 0x80000000 + 0x3ffff000 (see dma-ranges in the host bridge below).
+	 * [DRIVER] apple,s5l8960x-dart. Untested behind PCIe on this SoC.
+	 */
+	pcie_dart: iommu@602002000 {
+		compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
+		reg = <0x6 0x02002000 0x0 0x2000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_pcie>;
+		#iommu-cells = <1>;
+		status = "okay";
+	};
+
+	/*
+	 * [ADT] apcie,t7000: two-port PCIe root complex. Only port 1 is
+	 * populated on this board, by the Wi-Fi chip. 32 MSI vectors
+	 * starting at AIC 224 (Apple gives port 1 eight of them, from 8).
+	 *   port 1 PERST#   SoC GPIO 77
+	 *   port 1 CLKREQ#  SoC GPIO 41
+	 *   port 1 wake     SoC GPIO 43
+	 *   Wi-Fi REG_ON    PMU GPIO 5
+	 *   Wi-Fi host wake SoC GPIO 81
+	 * Link is limited to Gen1 (maximum-link-speed = 1).
+	 *
+	 * [DRIVER] pcie-apple.c, "apple,t7000-pcie". The register blocks were
+	 * identified from AppleT7000PCIe (see t7000-pcie-re.md). Apple's reg
+	 * order is config, port0, mmu0, port1, mmu1, common, phy0; it is
+	 * reordered here so that index 1 is the common block, which is where
+	 * the driver expects "rc".
+	 *
+	 *   rc     common block: per-port clocks and reset, PHY clock
+	 *   portN  per-port block: LTSSM, link status, interrupts, MSI
+	 *   phy0   PHY shared by ports 0 and 1
+	 *   mmuN   per-port "MMU" block, only read for error reporting
+	 *
+	 * Interrupts are per port (212 = port 0, 215 = port 1).
+	 */
+	pcie: pcie@610000000 {
+		compatible = "apple,t7000-pcie";
+		device_type = "pci";
+		reg = <0x6 0x10000000 0x0 0x1000000>,
+		      <0x6 0x00000000 0x0 0x2000>,
+		      <0x6 0x01004000 0x0 0x1000>,
+		      <0x6 0x02004000 0x0 0x1000>,
+		      <0x6 0x01005000 0x0 0x1000>,
+		      <0x6 0x01001000 0x0 0x1000>,
+		      <0x6 0x02001000 0x0 0x1000>;
+		reg-names = "config", "rc", "port0", "port1", "phy0",
+			    "mmu0", "mmu1";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 212 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>;
+		/* [ADT] msi-vector-offset 224, #msi-vectors 32 */
+		msi-controller;
+		msi-parent = <&pcie>;
+		msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+		/* [ADT] wlan iommu-parent = mapper-apcie1, SID 0 */
+		iommu-map = <0x100 &pcie_dart 0 1>;
+		iommu-map-mask = <0xff00>;
+		/*
+		 * pcie -> pcie_aux -> pcie_ref, chained at the bottom of this
+		 * file. Apple lists all three as clock gates of this node.
+		 */
+		power-domains = <&ps_pcie>;
+		bus-range = <0 8>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges = <0x43000000 0x6 0x20000000 0x6 0x20000000 0x1 0xa0000000>,
+			 <0x02000000 0x0 0xc0000000 0x7 0xc0000000 0x0 0x40000000>;
+		/*
+		 * [ADT] dart-apcie1 vm-offset = 0x80000000, vm-size = 0x3ffff000.
+		 * The firmware uses bus [0x80000000,0xBFFFF000) but the kernel
+		 * IOVA space starts at 0.  iBoot's hardware inbound window
+		 * should already accept 0x80000000 addresses.  dma-ranges stays
+		 * at [0, 0x3FFFF000] for the IOMMU to work; the brcmfmac
+		 * driver ORs 0x80000000 onto DMA addresses for the firmware.
+		 */
+		dma-ranges = <0x42000000 0x0 0x00000000 0x0 0x00000000 0x0 0x3ffff000>;
+		max-link-speed = <1>;
+		/* [ADT] phy0-settings: <offset value> */
+		apple,phy-settings = <0xc24 0x3f>, <0xc28 0x3f>;
+		/* [ADT] apcie-config-tunables: <offset mask value> */
+		apple,port-tunables = <0x090 0xff 0x28>,
+				      <0x130 0x03 0x03>,
+				      <0x134 0x01 0x01>;
+		status = "okay";
+
+		port01: pci@1,0 {
+			device_type = "pci";
+			reg = <0x800 0x0 0x0 0x0 0x0>;
+			bus-range = <1 1>;
+			reset-gpios = <&pinctrl 77 GPIO_ACTIVE_LOW>;
+			wake-gpios = <&pinctrl 43 GPIO_ACTIVE_LOW>; /* polarity [GUESS] */
+			max-link-speed = <1>;
+			/* [ADT] t-refclk-to-perst = 100 */
+			apple,t-refclk-to-perst-us = <100>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges;
+
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
+					<0 0 0 2 &port01 0 0 0 1>,
+					<0 0 0 3 &port01 0 0 0 2>,
+					<0 0 0 4 &port01 0 0 0 3>;
+
+			/*
+			 * [ADT] "wlan-pcie,bcm4357", /product wifi-chipset =
+			 * "4357", module-instance "crush". This is inside the
+			 * USI 339S00450 module. brcmfmac has no BCM4357
+			 * support, and the PCI device ID has not been read
+			 * from hardware, so no compatible is given.
+			 */
+			wifi: wifi@0,0 {
+				compatible = "pci14e4,440a", "brcm,bcm4329-fmac";
+				reg = <0x10000 0x0 0x0 0x0 0x0>;
+				brcm,board-type = "apple,crush";
+				/* apple,antenna-sku removed: firmware files lack the -XX suffix */
+				/* To be filled by loader */
+				local-mac-address = [00 00 00 00 00 00];
+			};
+		};
+	};
+};
+
+/*
+ * Not described on purpose:
+ *
+ *  - CPU operating points above 1128 MHz. iBoot fills in the voltage table
+ *    at boot and it has not been read on this board, so typhoon_opp06
+ *    (1392 MHz) stays disabled until that is checked.
+ *  - USB. The HoolockLinux t7000.dtsi already describes the DWC2 device
+ *    controller and its PHY in peripheral mode, which is what the debug
+ *    connector provides; nothing board-specific is needed. Apple's tree also
+ *    lists an EHCI/OHCI host port with a port node, use unknown.
+ *  - A framebuffer. The board has no display controller in use.
+ *  - SPI. There is no SPI controller in Apple's device tree for this board.
+ */
+
+/*
+ * [ADT] apcie clock-gates = PCIE, PCIE_AUX, PCIE_REF. The pmgr dtsi has no
+ * dependencies between them, so chain them here; the host bridge and its
+ * DART then only need ps_pcie.
+ */
+&ps_pcie {
+	power-domains = <&ps_pcie_aux>;
+};
+
+&ps_pcie_aux {
+	power-domains = <&ps_pcie_ref>;
+};
