+/* Protocol-layer half of the "state" debugfs file (see pcie.c). */
+void brcmf_msgbuf_dump_state(struct brcmf_pub *drvr, struct seq_file *s)
+{
+	struct brcmf_msgbuf *msgbuf;
+	u64 now = ktime_get_ns();
+	u16 i;
+
+	if (!drvr || !drvr->proto || !drvr->proto->pd)
+		return;
+	msgbuf = drvr->proto->pd;
+
+#define HP_AGO(t) ((t) ? (long long)div_u64(now - (t), NSEC_PER_MSEC) : -1LL)
+	seq_printf(s, "msgbuf: rx_cmpl=%llu (%lld ms ago) events=%llu (%lld ms ago) tx_posted=%llu tx_status=%llu (%lld ms ago)\n",
+		   msgbuf->hp.rx_cmpl, HP_AGO(msgbuf->hp.t_rx),
+		   msgbuf->hp.events, HP_AGO(msgbuf->hp.t_evt),
+		   msgbuf->hp.tx_posted, msgbuf->hp.tx_status,
+		   HP_AGO(msgbuf->hp.t_txs));
+	seq_printf(s, "msgbuf: ioctl_cmpl=%llu (%lld ms ago) ioctl_timeouts=%llu rx_bad_id=%llu rx_copy_fail=%llu no_pktid=%llu\n",
+		   msgbuf->hp.ioctl_cmpl, HP_AGO(msgbuf->hp.t_ioctl),
+		   msgbuf->hp.ioctl_timeouts, msgbuf->hp.rx_bad_id,
+		   msgbuf->hp.rx_copy_fail, msgbuf->hp.no_pktid);
+#undef HP_AGO
+	seq_printf(s, "msgbuf: rxbufpost=%u/%u eventbuf=%u/%u ioctlrespbuf=%u/%u rx_dataoffset=%u\n",
+		   msgbuf->rxbufpost, msgbuf->max_rxbufpost,
+		   msgbuf->cur_eventbuf, msgbuf->max_eventbuf,
+		   msgbuf->cur_ioctlrespbuf, msgbuf->max_ioctlrespbuf,
+		   msgbuf->rx_dataoffset);
+	seq_printf(s, "msgbuf: pktids in use rx=%u/%u (%s) tx=%u/%u (%s)\n",
+		   brcmf_msgbuf_pktids_in_use(msgbuf->rx_pktids),
+		   msgbuf->rx_pktids->array_size,
+		   msgbuf->rx_pktids->pool ? "static pool" : "per-packet map",
+		   brcmf_msgbuf_pktids_in_use(msgbuf->tx_pktids),
+		   msgbuf->tx_pktids->array_size,
+		   msgbuf->tx_pktids->pool ? "static pool" : "per-packet map");
+	for (i = 0; i < msgbuf->max_flowrings; i++) {
+		if (!msgbuf->flow || i >= msgbuf->flow->nrofrings ||
+		    !msgbuf->flow->rings[i])
+			continue;
+		seq_printf(s, "msgbuf: flowring %u: host r=%u w=%u outstanding_tx=%d queued=%u\n",
+			   i, msgbuf->flowrings[i]->r_ptr,
+			   msgbuf->flowrings[i]->w_ptr,
+			   atomic_read(&msgbuf->flowrings[i]->outstanding_tx),
+			   brcmf_flowring_qlen(msgbuf->flow, i));
+	}
+}
