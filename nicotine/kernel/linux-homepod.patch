+/*
+ * ---------------------------------------------------------------------------
+ * s5l8960x (T7000/A8 PCIe DART) diagnostics and experiment switches.
+ *
+ * WiFi on the HomePod (BCM4357 behind this DART) stops receiving after some
+ * traffic.  At some of those stalls the register at +0x1c holds a new address
+ * inside an ordinary buffer page and +0x10 reads 0x100 or 0x500; the fault
+ * interrupt has never fired.  Nobody knows yet what those two registers
+ * really latch, so this code does not interpret them: it watches them,
+ * and when they change it records what the page tables and the recent
+ * map/unmap history looked like at that moment.
+ *
+ * Everything is reachable at run time:
+ *   /sys/kernel/debug/apple-dart-s5l/{stats,events,history}
+ *   /sys/module/apple_dart/parameters/s5l_*   (also apple_dart.s5l_*= on the
+ *   kernel command line)
+ * ---------------------------------------------------------------------------
+ */
+static bool s5l_inval_on_map = true;
+module_param(s5l_inval_on_map, bool, 0644);
+MODULE_PARM_DESC(s5l_inval_on_map, "s5l8960x: invalidate the TLB after every map (default 1); 0 = only on unmap");
+
+static bool s5l_inval_secondary;
+module_param(s5l_inval_secondary, bool, 0644);
+MODULE_PARM_DESC(s5l_inval_secondary, "s5l8960x: also send the invalidate command to the block at base+0x2000 (only if it reports PARAMS != 0)");
+
+static bool s5l_force_rw;
+module_param(s5l_force_rw, bool, 0644);
+MODULE_PARM_DESC(s5l_force_rw, "s5l8960x: map every page read+write, whatever the DMA direction");
+
+static bool s5l_fault_clear;
+module_param(s5l_fault_clear, bool, 0644);
+MODULE_PARM_DESC(s5l_fault_clear, "s5l8960x: write the status back to +0x10 after an event (write-one-to-clear guess; default 0 = never write)");
+
+static unsigned int s5l_monitor_ms = 20;
+module_param(s5l_monitor_ms, uint, 0644);
+MODULE_PARM_DESC(s5l_monitor_ms, "s5l8960x: poll period of the +0x10/+0x1c monitor in ms (0 = off)");
+
+static unsigned int s5l_console = 8;
+module_param(s5l_console, uint, 0644);
+MODULE_PARM_DESC(s5l_console, "s5l8960x: how many events may still be printed to the kernel log (2 lines each)");
+
+#define S5L_HIST	256
+#define S5L_NREPORT	8
+#define S5L_REPORT_SZ	3072
+#define S5L_TRACK_PAGES	4096		/* IOVA pages below 16 MB */
+
+struct s5l_op {
+	u64 t_ns;
+	u64 paddr;
+	u32 iova;
+	u16 pages;
+	u8 unmap;
+	u8 prot;
+	u8 cpu;
+	char comm[11];
+};
+
+static struct {
+	spinlock_t lock;
+	struct apple_dart *dart;
+	struct apple_dart_domain *domain;
+	void __iomem *sec;			/* block at base + 0x2000 */
+	u32 sec_params;
+	struct timer_list timer;
+	bool timer_on;
+	u32 last_err, last_addr;
+	bool have_last;
+
+	struct s5l_op hist[S5L_HIST];
+	unsigned int head;
+	DECLARE_BITMAP(mapped, S5L_TRACK_PAGES);
+	u64 maps, unmaps, map_pages, unmap_pages, invals, invals_skipped, events;
+	long cur_pages, peak_pages;
+	u32 lowest_iova, highest_iova;
+	u64 last_inval_ns, last_map_ns, last_unmap_ns;
+
+	char *report[S5L_NREPORT];
+	unsigned int nreport;
+	struct dentry *dbg;
+} s5l = {
+	.lock = __SPIN_LOCK_UNLOCKED(s5l.lock),
+	.lowest_iova = 0xffffffff,
+};
+
+static unsigned long s5l_aperture_end = 0x00FFA000;
+
+static int s5l_aperture_end_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned long v;
+	int ret = kstrtoul(val, 0, &v);
+
+	if (ret)
+		return ret;
+	if (v < 0x00400000 || v > 0x00FFAFFF)
+		return -ERANGE;
+	s5l_aperture_end = v;
+	if (s5l.domain)
+		s5l.domain->domain.geometry.aperture_end = v;
+	return 0;
+}
+
+static const struct kernel_param_ops s5l_aperture_end_ops = {
+	.set = s5l_aperture_end_set,
+	.get = param_get_ulong,
+};
+module_param_cb(s5l_aperture_end, &s5l_aperture_end_ops, &s5l_aperture_end, 0644);
+MODULE_PARM_DESC(s5l_aperture_end, "s5l8960x: last usable IOVA (default 0xFFA000, the top page the DAPF lets through); takes effect for new allocations");
+
+u64 apple_dart_pgtable_peek(struct io_pgtable_ops *ops, unsigned long iova);
+
+static void s5l_note(struct apple_dart_domain *dom, unsigned long iova,
+		     phys_addr_t paddr, size_t bytes, int prot, bool unmap)
+{
+	unsigned long flags, pfn = iova >> 12, n = bytes >> 12, i;
+	struct s5l_op *op;
+	u64 now = ktime_get_ns();
+
+	if (!n)
+		return;
+	spin_lock_irqsave(&s5l.lock, flags);
+	op = &s5l.hist[s5l.head++ % S5L_HIST];
+	op->t_ns = now;
+	op->paddr = paddr;
+	op->iova = iova;
+	op->pages = n;
+	op->unmap = unmap;
+	op->prot = prot;
+	op->cpu = raw_smp_processor_id();
+	strscpy(op->comm, current->comm, sizeof(op->comm));
+	for (i = pfn; i < pfn + n && i < S5L_TRACK_PAGES; i++) {
+		if (unmap) {
+			if (__test_and_clear_bit(i, s5l.mapped))
+				s5l.cur_pages--;
+		} else if (!__test_and_set_bit(i, s5l.mapped)) {
+			s5l.cur_pages++;
+		}
+	}
+	if (unmap) {
+		s5l.unmaps++;
+		s5l.unmap_pages += n;
+		s5l.last_unmap_ns = now;
+	} else {
+		s5l.maps++;
+		s5l.map_pages += n;
+		s5l.last_map_ns = now;
+		if (iova < s5l.lowest_iova)
+			s5l.lowest_iova = iova;
+		if (iova + bytes - 1 > s5l.highest_iova)
+			s5l.highest_iova = iova + bytes - 1;
+		if (s5l.cur_pages > s5l.peak_pages)
+			s5l.peak_pages = s5l.cur_pages;
+	}
+	spin_unlock_irqrestore(&s5l.lock, flags);
+}
+
+static int s5l_fmt_op(char *buf, size_t len, const struct s5l_op *op, u64 now)
+{
+	return scnprintf(buf, len,
+			 "    %c iova=%06x pages=%u pa=%09llx prot=%x %8lld us ago cpu%u %s\n",
+			 op->unmap ? 'U' : 'M', op->iova, op->pages, op->paddr,
+			 op->prot, (s64)(now - op->t_ns) / 1000, op->cpu, op->comm);
+}
+
+/* Called with the registers already read; timer (softirq) or irq context. */
+static void s5l_event(u32 err, u32 addr, const char *why)
+{
+	struct apple_dart *dart = s5l.dart;
+	struct io_pgtable_ops *ops = s5l.domain ? s5l.domain->pgtbl_ops : NULL;
+	unsigned long flags, page = addr & ~0xfffUL;
+	u64 now = ktime_get_ns(), pte[3] = { 0, 0, 0 };
+	u32 regs[16], secerr = 0, secaddr = 0;
+	unsigned int i, n, shown;
+	char *r;
+	int o = 0, k;
+	bool mapped_now;
+
+	for (i = 0; i < 16; i++)
+		regs[i] = readl(dart->regs + 4 * i);
+	if (s5l.sec && s5l.sec_params) {
+		secerr = readl(s5l.sec + DART_S5L8960X_ERROR);
+		secaddr = readl(s5l.sec + DART_S5L8960X_ERROR_ADDR);
+	}
+	if (ops) {
+		if (page >= 0x1000)
+			pte[0] = apple_dart_pgtable_peek(ops, page - 0x1000);
+		pte[1] = apple_dart_pgtable_peek(ops, page);
+		pte[2] = apple_dart_pgtable_peek(ops, page + 0x1000);
+	}
+
+	spin_lock_irqsave(&s5l.lock, flags);
+	s5l.events++;
+	n = s5l.events;
+	mapped_now = (page >> 12) < S5L_TRACK_PAGES && test_bit(page >> 12, s5l.mapped);
+	r = s5l.report[(n - 1) % S5L_NREPORT];
+	if (r) {
+		o += scnprintf(r + o, S5L_REPORT_SZ - o,
+			       "event %u (%s) at %llu.%06llu s: +0x10=%08x +0x1c=%08x (before: %08x %08x)\n",
+			       n, why, now / NSEC_PER_SEC, (now % NSEC_PER_SEC) / 1000,
+			       err, addr, s5l.last_err, s5l.last_addr);
+		o += scnprintf(r + o, S5L_REPORT_SZ - o, "  regs 00..3c:");
+		for (i = 0; i < 16; i++)
+			o += scnprintf(r + o, S5L_REPORT_SZ - o, " %08x", regs[i]);
+		o += scnprintf(r + o, S5L_REPORT_SZ - o,
+			       "\n  block+0x2000: params=%08x +0x10=%08x +0x1c=%08x\n",
+			       s5l.sec_params, secerr, secaddr);
+		o += scnprintf(r + o, S5L_REPORT_SZ - o,
+			       "  page %06lx: pte=%llx (page below %llx, page above %llx) tracked as %s\n",
+			       page, pte[1], pte[0], pte[2], mapped_now ? "MAPPED" : "not mapped");
+		o += scnprintf(r + o, S5L_REPORT_SZ - o,
+			       "  since last: invalidate %lld us, map %lld us, unmap %lld us; maps=%llu unmaps=%llu invalidates=%llu (skipped %llu) mapped pages now=%ld peak=%ld\n",
+			       (s64)(now - s5l.last_inval_ns) / 1000,
+			       (s64)(now - s5l.last_map_ns) / 1000,
+			       (s64)(now - s5l.last_unmap_ns) / 1000,
+			       s5l.maps, s5l.unmaps, s5l.invals, s5l.invals_skipped,
+			       s5l.cur_pages, s5l.peak_pages);
+		o += scnprintf(r + o, S5L_REPORT_SZ - o,
+			       "  history of this page and its neighbours, newest first:\n");
+		shown = 0;
+		for (k = 0; k < S5L_HIST && shown < 16; k++) {
+			const struct s5l_op *op = &s5l.hist[(s5l.head - 1 - k) % S5L_HIST];
