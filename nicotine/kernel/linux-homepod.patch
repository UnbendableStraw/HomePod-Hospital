+static void s5l_monitor_fn(struct timer_list *t)
+{
+	struct apple_dart *dart = s5l.dart;
+	u32 err, addr;
+
+	if (!dart)
+		return;
+	if (s5l_monitor_ms) {
+		err = readl(dart->regs + DART_S5L8960X_ERROR);
+		addr = readl(dart->regs + DART_S5L8960X_ERROR_ADDR);
+		if (!s5l.have_last) {
+			s5l.last_err = err;
+			s5l.last_addr = addr;
+			s5l.have_last = true;
+		} else if (err != s5l.last_err || addr != s5l.last_addr) {
+			s5l_event(err, addr, "poll");
+		}
+	}
+	mod_timer(&s5l.timer, jiffies + msecs_to_jiffies(s5l_monitor_ms ? max(s5l_monitor_ms, 5u) : 250));
+}
+
+static int s5l_stats_show(struct seq_file *m, void *v)
+{
+	struct apple_dart *dart = s5l.dart;
+	unsigned long flags;
+	int i;
+
+	if (!dart)
+		return 0;
+	spin_lock_irqsave(&s5l.lock, flags);
+	seq_printf(m, "maps %llu (%llu pages)\nunmaps %llu (%llu pages)\n",
+		   s5l.maps, s5l.map_pages, s5l.unmaps, s5l.unmap_pages);
+	seq_printf(m, "invalidates %llu\ninvalidates_skipped_on_map %llu\nevents %llu\n",
+		   s5l.invals, s5l.invals_skipped, s5l.events);
+	seq_printf(m, "mapped_pages_now %ld\nmapped_pages_peak %ld\n",
+		   s5l.cur_pages, s5l.peak_pages);
+	seq_printf(m, "lowest_iova 0x%x\nhighest_iova 0x%x\n",
+		   s5l.lowest_iova, s5l.highest_iova);
+	seq_printf(m, "last_status 0x%08x\nlast_addr 0x%08x\n", s5l.last_err, s5l.last_addr);
+	spin_unlock_irqrestore(&s5l.lock, flags);
+	seq_printf(m, "aperture 0x%llx..0x%llx\n",
+		   s5l.domain ? (u64)s5l.domain->domain.geometry.aperture_start : 0,
+		   s5l.domain ? (u64)s5l.domain->domain.geometry.aperture_end : 0);
+	seq_printf(m, "switches inval_on_map=%d inval_secondary=%d force_rw=%d fault_clear=%d monitor_ms=%u console=%u\n",
+		   s5l_inval_on_map, s5l_inval_secondary, s5l_force_rw,
+		   s5l_fault_clear, s5l_monitor_ms, s5l_console);
+	seq_printf(m, "block+0x2000 params 0x%08x%s\n", s5l.sec_params,
+		   s5l.sec_params ? "" : " (reads 0: nothing there to configure or invalidate)");
+	seq_puts(m, "regs 00..3c:");
+	for (i = 0; i < 16; i++)
+		seq_printf(m, " %08x", readl(dart->regs + 4 * i));
+	seq_putc(m, '\n');
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(s5l_stats);
+
+static int s5l_events_show(struct seq_file *m, void *v)
+{
+	unsigned int n = s5l.events, first = n > S5L_NREPORT ? n - S5L_NREPORT : 0, i;
+
+	seq_printf(m, "%u event(s) so far; the last %d are kept\n", n, S5L_NREPORT);
+	for (i = first; i < n; i++)
+		if (s5l.report[i % S5L_NREPORT])
+			seq_puts(m, s5l.report[i % S5L_NREPORT]);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(s5l_events);
+
+static int s5l_history_show(struct seq_file *m, void *v)
+{
+	struct s5l_op *copy = kmalloc_array(S5L_HIST, sizeof(*copy), GFP_KERNEL);
+	unsigned long flags;
+	unsigned int head, k;
+	u64 now = ktime_get_ns();
+	char line[160];
+
+	if (!copy)
+		return -ENOMEM;
+	spin_lock_irqsave(&s5l.lock, flags);
+	memcpy(copy, s5l.hist, sizeof(s5l.hist));
+	head = s5l.head;
+	spin_unlock_irqrestore(&s5l.lock, flags);
+	seq_puts(m, "newest first; M = map, U = unmap\n");
+	for (k = 0; k < S5L_HIST && k < head; k++) {
+		s5l_fmt_op(line, sizeof(line), &copy[(head - 1 - k) % S5L_HIST], now);
+		seq_puts(m, line);
+	}
+	kfree(copy);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(s5l_history);
+
+static void s5l_monitor_start(struct apple_dart *dart, struct apple_dart_domain *dom)
+{
+	int i;
+
+	if (s5l.dart)
+		return;
+	for (i = 0; i < S5L_NREPORT; i++)
+		s5l.report[i] = kzalloc(S5L_REPORT_SZ, GFP_KERNEL);
+	s5l.domain = dom;
+	s5l.dart = dart;
+	s5l.dbg = debugfs_create_dir("apple-dart-s5l", NULL);
+	debugfs_create_file("stats", 0444, s5l.dbg, NULL, &s5l_stats_fops);
+	debugfs_create_file("events", 0444, s5l.dbg, NULL, &s5l_events_fops);
+	debugfs_create_file("history", 0444, s5l.dbg, NULL, &s5l_history_fops);
+	timer_setup(&s5l.timer, s5l_monitor_fn, 0);
+	mod_timer(&s5l.timer, jiffies + msecs_to_jiffies(100));
+	s5l.timer_on = true;
+}
