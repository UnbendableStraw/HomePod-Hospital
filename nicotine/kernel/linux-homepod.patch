+	if (!pdev)
+		return;
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd);
+	pci_read_config_word(pdev, PCI_STATUS, &sta);
+	pcie_capability_read_word(pdev, PCI_EXP_LNKCTL, &lnkctl);
+	pcie_capability_read_word(pdev, PCI_EXP_LNKSTA, &lnksta);
+	pcie_capability_read_word(pdev, PCI_EXP_DEVSTA, &devsta);
+	pos = pci_find_ext_capability(pdev, PCI_EXT_CAP_ID_L1SS);
+	if (pos)
+		pci_read_config_dword(pdev, pos + PCI_L1SS_CTL1, &l1ss);
+	seq_printf(s, "pci %-8s %s: cmd=0x%04x status=0x%04x devsta=0x%04x lnkctl=0x%04x (aspm %s%s%s) lnksta=0x%04x l1ss_ctl1=0x%08x\n",
